{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",

  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*token*": "deny",
      "**/*secret*": "deny",
      "**/*credential*": "deny",
      "**/notion_token*": "deny",
      "**/auth.json": "deny",
      "**/credentials.json": "deny",
      "**/service_account*.json": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/*token*": "deny",
      "**/*secret*": "deny",
      "**/*credential*": "deny",
      "**/notion_token*": "deny",
      "**/auth.json": "deny",
      "**/credentials.json": "deny",
      "**/service_account*.json": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "bash": {
      "*": "allow",
      "rm -rf*": "deny",
      "git reset --hard*": "deny",
      "git clean -fd*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push*main*": "deny",
      "git checkout main*": "deny",
      "git merge*": "deny",
      "chmod -R*": "deny",
      "chown -R*": "deny",
      "sudo*": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "ask",
    "task": "ask",
    "skill": "allow",
    "question": "allow",
    "doom_loop": "ask"
  }
}

# GMV CORE PATHS

GMV_CORE="$HOME/.gmv_core"

GMV_CONFIG="$GMV_CORE/00_CONFIG"
GMV_RUNTIME="$GMV_CORE/01_RUNTIME"
GMV_INDEXES="$GMV_CORE/02_INDEXES"
GMV_STATE="$GMV_CORE/03_STATE"
GMV_LOGS="$GMV_CORE/04_LOGS"
GMV_OUTPUT="$GMV_CORE/05_OUTPUT"
GMV_CACHE="$GMV_CORE/06_CACHE"
GMV_IMPORT="$GMV_CORE/07_IMPORT"
GMV_BACKUP_LOCAL="$GMV_CORE/08_BACKUP_LOCAL"


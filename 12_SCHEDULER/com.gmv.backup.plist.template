<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gmv.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__GMV_CORE__/12_SCHEDULER/run_backup.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__BACKUP_ROOT__/scheduler.out.log</string>
  <key>StandardErrorPath</key>
  <string>__BACKUP_ROOT__/scheduler.err.log</string>
</dict>
</plist>

;;
esac
;;

queue)
sub="${2:-}"

case "$sub" in
list)
"$HOME/.gmv_core/10_API/queue_service.py" list
;;

pending)
"$HOME/.gmv_core/10_API/queue_service.py" pending
;;

show)
IMPORT_ID="${3:-}"
if [ -z "$IMPORT_ID" ]; then
  echo "Usage: gmv queue show <import_id>"
  exit 2
fi
"$HOME/.gmv_core/10_API/queue_service.py" show "$IMPORT_ID"
;;

*)
echo "GMV QUEUE"
echo
echo "Commands:"
echo "  gmv queue list"
echo "  gmv queue pending"
echo "  gmv queue show <import_id>"
;;
esac
;;

search)
QUERY="${*:2}"
if [ -z "$QUERY" ]; then
  echo "Usage: gmv search <query>"
  exit 2
fi
"$HOME/.gmv_core/10_API/search_service.py" "$QUERY"
;;

folder-report)
shift
CORE_ROOT="${GMV_CORE_ROOT:-$HOME/.gmv_core}"
PYTHON_BIN="$CORE_ROOT/.venv/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="$(command -v python3)"
fi
"$PYTHON_BIN" "$CORE_ROOT/10_API/gmv_folder_report.py" "$@"
;;

run)
shift
CORE_ROOT="${GMV_CORE_ROOT:-$HOME/.gmv_core}"
PYTHON_BIN="$CORE_ROOT/.venv/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="$(command -v python3)"
fi
"$PYTHON_BIN" "$CORE_ROOT/10_API/gmv_run.py" "$@"
;;

migrate-plan)
shift
CORE_ROOT="${GMV_CORE_ROOT:-$HOME/.gmv_core}"
PYTHON_BIN="$CORE_ROOT/.venv/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="$(command -v python3)"
fi
"$PYTHON_BIN" "$CORE_ROOT/10_API/gmv_artist_migrate_plan.py" "$@"
;;

migrate-apply)
shift
CORE_ROOT="${GMV_CORE_ROOT:-$HOME/.gmv_core}"
PYTHON_BIN="$CORE_ROOT/.venv/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="$(command -v python3)"
fi
"$PYTHON_BIN" "$CORE_ROOT/10_API/gmv_artist_migrate_apply.py" "$@"
;;


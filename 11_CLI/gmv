show)
IDENTIFIER="${3:-}"
if [ -z "$IDENTIFIER" ]; then
  echo "Usage: gmv plugin show <PLG-OID or slug>"
  exit 2
fi
"$HOME/.gmv_core/10_API/plugin_service.py" show "$IDENTIFIER"

if [ -z "$QUERY" ]; then
  echo "Usage: gmv search <query>"
  exit 2
fi
"$HOME/.gmv_core/10_API/search_service.py" "$QUERY"
;;

snapshot)
sub="${2:-}"

case "$sub" in

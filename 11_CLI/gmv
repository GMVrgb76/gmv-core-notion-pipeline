#!/bin/bash

set -euo pipefail

command_name="${1:-}"

case "$command_name" in

status)
shift
"$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../10_API" && pwd)/status_service.py" "$@"
;;

doctor)
if [ "${2:-}" = "--strict" ]; then
  shift 2
  "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../10_API" && pwd)/doctor_service.py" "$@"
  exit $?
fi
"$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../10_API" && pwd)/doctor_service.py" --legacy
exit $?
;;

object)
sub="${2:-}"

case "$sub" in
list)
"$HOME/.gmv_core/10_API/object_service.py" list
;;

show)
OID="${3:-}"
if [ -z "$OID" ]; then
  echo "Usage: gmv object show <OID>"
  exit 2
fi
"$HOME/.gmv_core/10_API/object_service.py" show "$OID"
;;

count)
"$HOME/.gmv_core/10_API/object_service.py" count
;;

*)
echo "GMV OBJECT"
echo
echo "Commands:"
echo "  gmv object list"
echo "  gmv object show <OID>"
echo "  gmv object count"
echo "  gmv relation list"
echo "  gmv relation count"
echo "  gmv relation show <OID>"
echo "  gmv import file <path>"
;;
esac
;;


resource)
sub="${2:-}"

case "$sub" in
list)
"$HOME/.gmv_core/10_API/resource_service.py" list
;;

show)
OID="${3:-}"
if [ -z "$OID" ]; then
  echo "Usage: gmv resource show <RES-OID>"
  exit 2
fi
"$HOME/.gmv_core/10_API/resource_service.py" show "$OID"
;;

count)
"$HOME/.gmv_core/10_API/resource_service.py" count
;;

*)
echo "GMV RESOURCE"
echo
echo "Commands:"
echo "  gmv resource list"
echo "  gmv resource show <RES-OID>"
echo "  gmv resource count"
;;
esac
;;


relation)
sub="${2:-}"

case "$sub" in
list)
"$HOME/.gmv_core/10_API/relation_service.py" list
;;

count)
"$HOME/.gmv_core/10_API/relation_service.py" count
;;

show)
OID="${3:-}"
if [ -z "$OID" ]; then
  echo "Usage: gmv relation show <OID>"
  exit 2
fi
"$HOME/.gmv_core/10_API/relation_service.py" show "$OID"
;;

*)
echo "GMV RELATION"
echo
echo "Commands:"
echo "  gmv relation list"
echo "  gmv relation count"
echo "  gmv relation show <OID>"
echo "  gmv import file <path>"
;;
esac
;;


event)
sub="${2:-}"

case "$sub" in
latest)
"$HOME/.gmv_core/10_API/event_service.py" latest
;;

show)
OID="${3:-}"
if [ -z "$OID" ]; then
  echo "Usage: gmv event show <OID>"
  exit 2
fi
"$HOME/.gmv_core/10_API/event_service.py" show "$OID"
;;

count)
"$HOME/.gmv_core/10_API/event_service.py" count
;;

*)
echo "GMV EVENT"
echo
echo "Commands:"
echo "  gmv event latest"
echo "  gmv event show <OID>"
echo "  gmv event count"
;;
esac
;;


timeline)
sub="${2:-}"

case "$sub" in
latest)
"$HOME/.gmv_core/10_API/timeline_service.py" latest
;;

show)
OID="${3:-}"
if [ -z "$OID" ]; then
  echo "Usage: gmv timeline show <OID>"
  exit 2
fi
"$HOME/.gmv_core/10_API/timeline_service.py" show "$OID"
;;

*)
echo "GMV TIMELINE"
echo
echo "Commands:"
echo "  gmv timeline latest"
echo "  gmv timeline show <OID>"

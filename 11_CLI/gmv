"$PYTHON_BIN" "$CORE_ROOT/10_API/gmv_artist_normalize_plan.py" "$@"
;;

evidence)
shift
CORE_ROOT="${GMV_CORE_ROOT:-$HOME/.gmv_core}"
PYTHON_BIN="$CORE_ROOT/.venv/bin/python"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="$(command -v python3)"
fi
if [ "${1:-}" = "candidate" ] || [ "${1:-}" = "notion-plan" ]; then
  shift
  "$PYTHON_BIN" "$CORE_ROOT/10_API/gmv_notion_candidate.py" "$@"
else
  "$PYTHON_BIN" "$CORE_ROOT/10_API/gmv_evidence_pipeline.py" "$@"
fi
;;

snapshot)
sub="${2:-}"

case "$sub" in
create)
"$HOME/.gmv_core/10_API/snapshot_service.py" create
;;

list)
"$HOME/.gmv_core/10_API/snapshot_service.py" list
;;

inspect|verify)
TARGET="${3:-}"
if [ -z "$TARGET" ]; then
  echo "Usage: gmv snapshot $sub <BACKUP_PATH>"
  exit 2
fi
"$HOME/.gmv_core/10_API/backup_service.py" "$sub" "$TARGET"
;;

restore-check)
BACKUP="${3:-}"
TARGET="${4:-}"
CORE="${5:-}"
if [ -z "$BACKUP" ] || [ -z "$TARGET" ]; then
  echo "Usage: gmv snapshot restore-check <BACKUP_PATH> <ISOLATED_TARGET> [CORE_PATH]"
  exit 2
fi
if [ -n "$CORE" ]; then
  "$HOME/.gmv_core/10_API/backup_service.py" restore-check "$BACKUP" "$TARGET" --core "$CORE"
else
  "$HOME/.gmv_core/10_API/backup_service.py" restore-check "$BACKUP" "$TARGET"
fi
;;

*)
echo "GMV SNAPSHOT"
echo
echo "Commands:"
echo "  gmv snapshot create"
echo "  gmv snapshot list"
echo "  gmv snapshot inspect <BACKUP_PATH>"
echo "  gmv snapshot verify <BACKUP_PATH>"
echo "  gmv snapshot restore-check <BACKUP_PATH> <ISOLATED_TARGET> [CORE_PATH]"
;;
esac
;;

service)
sub="${2:-}"

case "$sub" in
list)
"$HOME/.gmv_core/10_API/service_service.py" list
;;

runs)
"$HOME/.gmv_core/10_API/service_service.py" runs
;;

show)
OID="${3:-}"
if [ -z "$OID" ]; then
  echo "Usage: gmv service show <SRV-OID>"
  exit 2
fi
"$HOME/.gmv_core/10_API/service_service.py" show "$OID"
;;

*)
echo "GMV SERVICE"
echo
echo "Commands:"
echo "  gmv service list"
echo "  gmv service runs"
echo "  gmv service show <SRV-OID>"
;;
esac
;;

plugin)
sub="${2:-}"

case "$sub" in

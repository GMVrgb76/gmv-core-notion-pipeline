"$HOME/.gmv_core/10_API/event_service.py" count
;;

*)
echo "GMV EVENT"
echo
echo "Commands:"
echo "  gmv event latest"
echo "  gmv event show <OID>"
echo "  gmv event count"
;;
esac
;;


timeline)

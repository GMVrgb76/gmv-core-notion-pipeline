echo "  gmv object count"
echo "  gmv resource list"
echo "  gmv resource show <RES-OID>"
echo "  gmv resource count"
echo "  gmv relation list"
echo "  gmv relation count"
echo "  gmv relation show <OID>"
echo "  gmv event latest"
echo "  gmv event show <OID>"
echo "  gmv event count"
echo "  gmv timeline latest"
echo "  gmv timeline show <OID>"
echo "  gmv search <query>"
echo "  gmv folder-report <source> [--master <path>] [-o <report.md>]"
echo "  gmv migrate-plan <source_folder> --report <folder_report.md> --template <canon_template_path> --artist <name> --destination-root <path> [-o <plan.yaml>]"
echo "  gmv migrate-apply <plan.yaml>"
echo "  gmv artist-import <source_artist_folder> [--artist <name>] [--template <path>] [--destination-root <path>] [--qa-root <path>]"
echo "  gmv artist-normalize-plan <artist_folder> [--template <path>] [--model <name>] [--timeout <seconds>] [--batch-size <n>]"
echo "  gmv evidence scan <dropbox_root> [--evidence-root <path>]"
echo "  gmv evidence extract <dropbox_root> [--evidence-root <path>]"
echo "  gmv evidence analyze <extraction_record.json> --model <ollama-model> [--resume] [--retry-limit <n>]"
echo "  gmv evidence resolve <semantic.json> --rows <rows.json>"
echo "  gmv evidence candidate <entity-name> --entity-type <type> --claims <claims.json> --rows <rows.json> --config <config.json> [--run-dir <run>]"
echo "  gmv queue list"
echo "  gmv queue pending"
echo "  gmv queue show <import_id>"
echo "  gmv snapshot create"
echo "  gmv snapshot list"
echo "  gmv import file <path>"
echo "  gmv import queue"
echo "  gmv import pending"
;;
esac

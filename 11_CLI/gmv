;;


import)
sub="${2:-}"

case "$sub" in
file)
TARGET="${3:-}"
if [ -z "$TARGET" ]; then
  echo "Usage: gmv import file <path>"
  exit 2
fi
"$HOME/.gmv_core/10_API/import_service.py" file "$TARGET"
;;

queue)
"$HOME/.gmv_core/10_API/import_service.py" queue
;;

pending)
"$HOME/.gmv_core/10_API/import_service.py" pending
;;

*)
echo "GMV IMPORT"
echo
echo "Commands:"
echo "  gmv import file <path>"
echo "  gmv import queue"
